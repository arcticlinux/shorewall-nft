[Unit]
Description=Shorewall-nft firewall
Documentation=man:shorewall(8)
# Start after the network is online, so provider routing and routes-file
# entries can reach nexthops on interfaces the network manager just brought
# up. Do not run beside another firewall manager.
Wants=network-online.target
After=network-online.target
Conflicts=firewalld.service ufw.service

[Service]
# /run/shorewall-nft is shared by shorewall and shorewall-lsm (both IPv4). systemd
# creates it for each, but does not count users: without Preserve, stopping any
# one unit would delete the state (default.save, providers/) the others still use.
RuntimeDirectory=shorewall-nft
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/shorewall start
ExecStop=/usr/sbin/shorewall stop
ExecReload=/usr/sbin/shorewall reload
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
